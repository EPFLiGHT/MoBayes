#!/bin/sh
# Format staged webapp files with Prettier, then restage them.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^webapp/.*\.(ts|tsx|css|md|json)$' || true)
[ -z "$staged" ] && exit 0

echo "$staged" | sed 's|^webapp/||' | (cd webapp && xargs npx prettier --write --ignore-unknown)
echo "$staged" | xargs git add
